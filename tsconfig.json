{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "rootDir": "frontend",
    "outDir": "public/assets/js",
    "strict": true,
    "noEmitOnError": true,
    "lib": ["ES2020", "DOM"],
    "skipLibCheck": true
  },
  "include": ["frontend/**/*.ts"]
}
